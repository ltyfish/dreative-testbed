{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreative.dev/schemas/showcase-mechanism.schema.json",
  "title": "Dreative Showcase mechanism contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "experienceType", "classification", "recommendedBaseline", "showcaseDelta", "mediaOpportunities", "prototypeEvidence", "prototypeFidelity", "continuity", "mechanisms"],
  "properties": {
    "version": { "const": 2 },
    "experienceType": { "enum": ["journey", "interface"] },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation"],
      "properties": {
        "implementation": { "const": "attempted" }
      }
    },
    "recommendedBaseline": { "type": "string", "minLength": 1 },
    "showcaseDelta": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "mediaOpportunities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opportunity", "decision", "rationale"],
        "properties": {
          "opportunity": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["use", "reject"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prototypeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundedApproach", "higherCeilingApproach", "selectedApproach", "selectedBy", "boundedArtifact", "higherCeilingArtifact", "boundedCaptures", "higherCeilingCaptures", "boundedRecordings", "higherCeilingRecordings", "builderSelectionRationale"],
      "properties": {
        "boundedApproach": { "type": "string", "minLength": 1 },
        "higherCeilingApproach": { "type": "string", "minLength": 1 },
        "selectedApproach": { "type": "string", "minLength": 1 },
        "selectedBy": { "const": "user" },
        "boundedArtifact": { "type": "string", "minLength": 1 },
        "higherCeilingArtifact": { "type": "string", "minLength": 1 },
        "boundedCaptures": { "$ref": "#/$defs/responsiveCaptures" },
        "higherCeilingCaptures": { "$ref": "#/$defs/responsiveCaptures" },
        "boundedRecordings": { "$ref": "#/$defs/responsiveRecordings" },
        "higherCeilingRecordings": { "$ref": "#/$defs/responsiveRecordings" },
        "builderSelectionRationale": { "type": "string", "minLength": 1 }
      }
    },
    "prototypeFidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedArtifact", "prototypeSubjectSelector", "integratedSubjectSelector", "focalObject", "copyBalance", "controlPlacement", "materialLighting", "desktopFraming", "mobileFraming"],
      "properties": {
        "selectedArtifact": { "type": "string", "minLength": 1 },
        "prototypeSubjectSelector": { "type": "string", "minLength": 1 },
        "integratedSubjectSelector": { "type": "string", "minLength": 1 },
        "focalObject": { "type": "string", "minLength": 1 },
        "copyBalance": { "type": "string", "minLength": 1 },
        "controlPlacement": { "type": "string", "minLength": 1 },
        "materialLighting": { "type": "string", "minLength": 1 },
        "desktopFraming": { "type": "string", "minLength": 1 },
        "mobileFraming": { "type": "string", "minLength": 1 }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateKey", "sourceSelector", "sourceTrigger", "stateCount", "affectedRegions"],
      "properties": {
        "stateKey": { "type": "string", "minLength": 1 },
        "sourceSelector": { "type": "string", "minLength": 1 },
        "sourceTrigger": { "enum": ["click", "drag"] },
        "stateCount": { "type": "integer", "minimum": 2, "maximum": 5 },
        "affectedRegions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "stage", "effect"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "stage": { "enum": ["before", "peak", "after"] },
              "effect": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stage", "selector", "primarySelector", "primarySubject", "trigger", "experienceRole", "ceilingContribution", "mediaMode", "continuityConnection", "mobileTransformation", "recommendedDifference", "meaningfulOutcome", "animationOwner", "ownedProperties", "stateCount"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["before", "peak", "after"] },
          "selector": { "type": "string", "minLength": 1 },
          "primarySelector": { "type": "string", "minLength": 1 },
          "primarySubject": { "type": "string", "minLength": 1 },
          "trigger": { "enum": ["scroll", "click", "hover", "drag"] },
          "experienceRole": { "type": "string", "minLength": 1 },
          "ceilingContribution": { "type": "string", "minLength": 1 },
          "mediaMode": { "enum": ["dom-state", "typography", "image", "video", "svg", "canvas", "spatial-layout", "3d"] },
          "continuityConnection": { "type": "string", "minLength": 1 },
          "mobileTransformation": { "type": "string", "minLength": 1 },
          "recommendedDifference": { "type": "string", "minLength": 1 },
          "meaningfulOutcome": { "type": "string", "minLength": 1 },
          "animationOwner": { "enum": ["css", "gsap", "motion", "anime", "react-state", "native-js", "other"] },
          "ownedProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "stateCount": { "type": "integer", "minimum": 2, "maximum": 5 }
        }
      }
    },
    "responsiveRecordings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "mobile"],
      "properties": {
        "desktop": { "type": "string", "minLength": 1 },
        "mobile": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "responsiveCaptures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "mobile"],
      "properties": {
        "desktop": { "type": "string", "minLength": 1 },
        "mobile": { "type": "string", "minLength": 1 }
      }
    }
  }
}
