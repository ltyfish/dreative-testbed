{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreative.dev/schemas/showcase-mechanism.schema.json",
  "title": "Showcase connected-experience contract",
  "description": "Routes a Showcase build to browser verification. Every field is either exercised against the rendered page or read by a human reviewer. Fields describing the builder's own process — rationales, prototype acceptance, frame counts, feasibility narratives — are deliberately absent: a non-empty string is not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "experienceType", "signature", "referenceMode", "referenceAdoptions", "assetCommitments", "continuity", "mechanisms"],
  "properties": {
    "version": { "const": 3 },
    "experienceType": { "enum": ["journey", "interface"] },
    "signature": {
      "type": "object",
      "description": "The one component on this route that could not be lifted onto a competitor's page. Verified to resolve, render, and occupy at least 5% of the viewport.",
      "additionalProperties": false,
      "required": ["name", "selector", "whyOnlyThisProduct"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "whyOnlyThisProduct": { "type": "string", "minLength": 1 }
      }
    },
    "referenceMode": { "enum": ["none", "supplied", "scout"] },
    "referenceAdoptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sourceRef", "rights", "principle", "decision"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1, "description": "A real URL or repository-relative file. Remote refs are requested; local refs must exist." },
          "rights": { "type": "string", "minLength": 1 },
          "principle": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["use", "reject"] },
          "targetSelector": { "type": "string", "minLength": 1, "description": "Required when decision is use; must render visibly." }
        }
      }
    },
    "assetCommitments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "decision", "targetSelector", "medium", "sourceKind", "sourceRef", "rights", "mobileFallback"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["use", "reject"] },
          "targetSelector": { "type": "string", "minLength": 1 },
          "medium": { "enum": ["image", "video", "svg", "canvas", "3d", "none"] },
          "sourceKind": { "enum": ["local-file", "remote-url", "inline", "none"] },
          "sourceRef": { "type": "string", "minLength": 1 },
          "rights": { "type": "string", "minLength": 1 },
          "mobileFallback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "continuity": {
      "type": "object",
      "description": "One connected experience spanning before, peak, and after. Shared state is exercised from its source; an authored sequence is checked for document order.",
      "additionalProperties": false,
      "required": ["mode", "affectedRegions"],
      "properties": {
        "mode": { "enum": ["shared-state", "authored-sequence"] },
        "motif": { "type": "string", "minLength": 1 },
        "stateKey": { "type": "string", "minLength": 1 },
        "sourceSelector": { "type": "string", "minLength": 1 },
        "sourceTrigger": { "enum": ["click", "drag"] },
        "stateCount": { "type": "integer", "minimum": 2 },
        "affectedRegions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "stage", "effect"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "stage": { "enum": ["before", "peak", "after"] },
              "effect": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "description": "Declared only when the route compares items. Checked for one thing: the items render visibly distinct values, rather than reading as repeated cards.",
      "additionalProperties": false,
      "required": ["selector", "itemSelector", "identityAttribute", "identityChannels"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "itemSelector": { "type": "string", "minLength": 1 },
        "identityAttribute": { "type": "string", "pattern": "^data-[a-z0-9-]+$" },
        "identityChannels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "selector", "uniqueProperty"],
            "properties": {
              "channel": { "type": "string", "minLength": 1 },
              "selector": { "type": "string", "minLength": 1, "description": "$self targets the item itself." },
              "uniqueProperty": { "enum": ["src", "background-image", "background-color", "border-radius", "clip-path"] }
            }
          }
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stage", "selector", "primarySelector", "primarySubject", "trigger", "mediaMode", "mobileTransformation", "visibleChange", "animationOwner", "ownedProperties", "stateCount"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["before", "peak", "after"] },
          "selector": { "type": "string", "minLength": 1 },
          "primarySelector": { "type": "string", "minLength": 1 },
          "primarySubject": { "type": "string", "minLength": 1, "description": "The real product subject. Decorative or aria-hidden elements are rejected at runtime." },
          "trigger": { "enum": ["scroll", "click", "hover", "drag", "time", "media", "load", "route", "none"] },
          "mediaMode": { "enum": ["dom-state", "typography", "image", "video", "svg", "canvas", "spatial-layout", "3d"] },
          "mobileTransformation": { "type": "string", "minLength": 1 },
          "visibleChange": { "type": "string", "minLength": 1 },
          "animationOwner": { "enum": ["css", "gsap", "motion", "anime", "react-state", "native-js", "other"] },
          "ownedProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "stateCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
