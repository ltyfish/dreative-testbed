node_modules
dist

# Runs are disposable working copies: node_modules junctions, absolute paths, half-built
# state — none of it survives a pull on another machine. `archive/` is the committed copy
# that does, and it is deliberately NOT ignored.
runs/*
!runs/.gitkeep

# Dreative working output: prototypes, recordings, caches, traces.
.dreative/

# Two contract files from 202608110800 sit under archive/ and stay tracked anyway,
# because an ignore rule does not untrack. They were recovered by hand and are a one-off:
# no script reads them, the archive viewer never shows them, and scoring never touches
# them. If a later round genuinely needs the Experience Map and Showcase contract
# archived, copy them in `archiveRun` (scripts/lib/archive.mjs) and unignore them here.
# Not speculatively — an unread file is cost, not evidence.

# Skill trees extracted from the code repo for a --skill-<arm> comparison. Reproducible
# from git at any time, so they are cache, not evidence.
scratch/skill-*/

# The installed skill. Deliberately not committed: the `with` arm has to test whatever version
# of Dreative you are working on now, and a committed copy silently tests a stale one — the
# tracked copy had drifted about a month behind before this rule existed (2026-08-30).
# `setup.mjs --skill-from ../Dreative` installs it, and `run-all.mjs` refuses to start without
# it, so a fresh clone cannot accidentally run against nothing.
.claude/
.codex/
