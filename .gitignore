node_modules
dist

# Runs are disposable working copies: node_modules junctions, absolute paths, half-built
# state — none of it survives a pull on another machine. `archive/` is the committed copy
# that does, and it is deliberately NOT ignored.
runs/*
!runs/.gitkeep

# Dreative working output: prototypes, recordings, caches, traces.
.dreative/

# ...except inside `archive/`. The Experience Map and Showcase contract are the
# skill's own portable, tracked evidence files; dropping them from the archived
# copy means a later round cannot check what the build actually promised.
!archive/**/.dreative/
!archive/**/.dreative/*.json
