+          ))}
+        </div>
+        <footer>
+          <div><span>Subtotal</span><strong>{money(subtotal)}</strong></div>
+          <p>{subtotal === 0 ? 'Free UK delivery over £100.' : remaining > 0 ? `${money(remaining)} more for free delivery. Delivery is £4.95.` : 'Delivery free.'}</p>
