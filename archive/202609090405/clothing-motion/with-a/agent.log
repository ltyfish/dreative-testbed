+.bag-sheet > header button, .bag-lines button { min-height: 44px; padding: 0 13px; border: 1px solid currentColor; background: transparent; cursor: pointer; text-transform: uppercase; font-size: 12px; }
+.bag-sheet button:hover, .bag-sheet button:focus { background: #f2b632; color: #16243b; }
+.bag-lines { flex: 1; }
+.empty-bag { margin: 70px 0; font-family: 'Instrument Serif', serif; font-size: 37px; line-height: 1.05; }
+.empty-bag span { font-family: 'DM Mono', monospace; font-size: 12px; text-transform: uppercase; }
+.bag-lines article { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 18px; padding: 22px 0; border-bottom: 1px solid rgba(22,36,59,.35); }
+.bag-lines article > div { display: flex; flex-direction: column; gap: 6px; }
+.bag-lines article > div strong { font-family: 'Instrument Serif', serif; font-size: 28px; font-weight: 400; }
+.bag-lines article span, .bag-lines article p { font-size: 12px; }
+.bag-sheet > footer { padding-top: 30px; border-top: 1px solid #16243b; }
+.bag-sheet > footer > div { display: flex; justify-content: space-between; padding: 9px 0; font-size: 13px; }
+.bag-sheet > footer > p { padding-bottom: 18px; font-size: 12px; text-transform: uppercase; }
+.bag-total { margin-top: 10px; border-top: 1px solid #16243b; font-family: 'Instrument Serif', serif; font-size: 28px !important; }
+.checkout { width: 100%; min-height: 58px; margin-top: 18px; border: 0; background: #761f25; color: #fff8e9; cursor: pointer; text-transform: uppercase; }
+
+@media (max-width: 900px) {
+  .collection { padding: 90px 16px 110px; }
+  .collection-head { grid-template-columns: 1fr; margin-bottom: 65px; }
+  .collection-head h2 { font-size: clamp(70px, 21vw, 104px); }
+  .collection-intro { max-width: 40ch; }
+  .filters { top: 0; margin-inline: -16px; overflow-x: auto; grid-template-columns: repeat(5, minmax(118px, 1fr)); }
+  .filters button { min-height: 54px; }
+  .showing { margin-bottom: 45px; text-align: left; }
+  .garment-grid { grid-template-columns: 1fr; row-gap: 95px; }
+  .garment, .garment:nth-child(5n + 1), .garment:nth-child(5n + 2), .garment:nth-child(5n + 3), .garment:nth-child(5n + 4) { grid-column: 1; margin-top: 0; }
+  .garment:nth-child(even) { margin-left: 9vw; }
+  .garment:nth-child(odd) { margin-right: 9vw; }
+  .garment-image { aspect-ratio: 1 / 1.08; }
+  .garment-summary { padding-inline: 0; }
+  .garment-title h3 { font-size: 45px; }
+  .garment-detail { min-height: 0; font-size: 21px; }
+  .concept-note { margin-top: 90px; }
+  .measurements, .care-section, .shipping-section { grid-template-columns: 1fr; padding: 90px 16px; }
+  .measure-title, .care-section header, .shipping-section header { position: static; }
+  .measure-title h2, .care-section h2, .shipping-section h2 { font-size: clamp(65px, 19vw, 94px); }
+  .measure-title h2 { margin: 40px 0; }
+  .size-table-wrap th, .size-table-wrap td { padding: 18px 6px; font-size: 17px; }
+  .size-table-wrap > p { font-size: 23px; }
+  .care-section ol { margin-top: 40px; }
+  .care-section li { grid-template-columns: 40px 1fr; padding: 25px 0 50px; }
+  .care-section li > p { font-size: 30px; }
+  .reviews-section { padding: 90px 16px 130px; }
+  .reviews-section header { display: block; }
+  .reviews-section h2 { margin-top: 35px; }
+  .reviews { grid-template-columns: 1fr; gap: 26px; }
+  .reviews figure, .reviews figure:nth-child(2), .reviews figure:nth-child(3) { min-height: 440px; transform: none; }
+  .reviews blockquote { font-size: 29px; }
+  .shop-story { padding: 100px 16px; }
+  .shop-story header { grid-template-columns: 1fr; margin-bottom: 70px; }
+  .shop-story h2 { font-size: clamp(61px, 17vw, 85px); }
+  .shop-facts { grid-template-columns: 1fr; }
+  .shop-facts article { min-height: 300px; border-right: 0; border-bottom: 1px solid #16243b; }
+  .shop-facts article:last-child { border-bottom: 0; }
+  .shop-facts p { margin-top: 65px; font-size: 31px; }
+  .factory-ledger { grid-template-columns: 1fr; margin-top: 75px; }
+  .factory-ledger li { font-size: 27px; }
+  .shipping-list { padding-top: 35px; }
+  .shipping-list p { font-size: 29px; }
+  .site-footer { min-height: 65svh; padding: 50px 16px 24px; grid-template-columns: 1fr auto; }
+  .site-footer > a { font-size: clamp(69px, 23vw, 108px); }
+  .site-footer button { grid-column: 2; }
+  .bag-sheet { padding: 20px 16px; }
+}
+
+@media (max-width: 380px) {
+  .garment:nth-child(even) { margin-left: 3vw; }
+  .garment:nth-child(odd) { margin-right: 3vw; }
+  .garment-title h3 { font-size: 40px; }
+  .factory-ledger li { font-size: 23px; }
+  .bag-lines article { grid-template-columns: 1fr auto; }
+  .bag-lines article button { grid-column: 1 / -1; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-reveal] { opacity: 1; transform: none; transition: none; }
+  .garment-image img, .add-button, .release strong { transition: none; }
+  .bag-sheet { animation: none; }
+}

diff --git a/runs/clothing-motion__with-a__202609090405/.dreative/shop-check.mjs b/runs/clothing-motion__with-a__202609090405/.dreative/shop-check.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3c8bfdb45facedac5486b061f8902d0f2f044827
--- /dev/null
+++ b/runs/clothing-motion__with-a__202609090405/.dreative/shop-check.mjs
@@ -0,0 +1,40 @@
+import { chromium } from 'file:///C:/Users/lty/AppData/Roaming/npm/node_modules/dreative/node_modules/playwright/index.mjs'
+
+const browser = await chromium.launch({ headless: true })
+try {
+  const mobile = await browser.newContext({ viewport: { width: 390, height: 844 }, hasTouch: true, isMobile: true })
+  const page = await mobile.newPage()
+  const errors = []
+  page.on('console', (message) => message.type() === 'error' && errors.push(message.text()))
+  await page.goto('http://127.0.0.1:4173/', { waitUntil: 'networkidle' })
+  await page.locator('#collection').scrollIntoViewIfNeeded()
+  await page.getByRole('button', { name: 'Shirts 2' }).click()
+  if (await page.locator('.garment').count() !== 2) throw new Error('Shirts filter did not resolve to 2 garments')
+  const oxford = page.locator('.garment-oxford')
+  if (!(await oxford.getByRole('button', { name: 'XS, sold out' }).isDisabled())) throw new Error('Oxford XS is not disabled')
+  await oxford.getByRole('button', { name: 'S', exact: true }).click()
+  await oxford.getByRole('button', { name: 'Add size S' }).click()
+  const dialog = page.getByRole('dialog')
+  await dialog.waitFor({ state: 'visible' })
+  const bagText = await dialog.innerText()
+  for (const expected of ['The Oxford Shirt', 'Size S', '£78.00', '£22.00 more for free delivery', '£4.95', '£82.95']) {
+    if (!bagText.toLowerCase().includes(expected.toLowerCase())) throw new Error(`Bag is missing: ${expected}`)
+  }
+  await dialog.getByRole('button', { name: 'Remove' }).click()
+  if (!(await dialog.innerText()).toLowerCase().includes('£100.00 away from free delivery')) throw new Error('Empty bag threshold is incorrect')
+  await dialog.getByRole('button', { name: 'Close ×' }).click()
+  if (errors.length) throw new Error(`Console errors: ${errors.join(' | ')}`)
+  await mobile.close()
+
+  const reduced = await browser.newContext({ viewport: { width: 390, height: 844 }, reducedMotion: 'reduce' })
+  const reducedPage = await reduced.newPage()
+  await reducedPage.goto('http://127.0.0.1:4173/', { waitUntil: 'networkidle' })
+  if (await reducedPage.locator('.relay').getAttribute('data-phase') !== 'shop') throw new Error('Reduced-motion relay did not resolve to shop state')
+  if (await reducedPage.locator('.product-panel').evaluate((element) => getComputedStyle(element).opacity) !== '1') throw new Error('Reduced-motion product panel is hidden')
+  await reducedPage.locator('.care-section').scrollIntoViewIfNeeded()
+  if (await reducedPage.locator('.care-section [data-reveal]').first().evaluate((element) => getComputedStyle(element).opacity) !== '1') throw new Error('Reduced-motion reveal remained hidden')
+  await reduced.close()
+  console.log('SHOP_CHECK_PASSED')
+} finally {
+  await browser.close()
+}
