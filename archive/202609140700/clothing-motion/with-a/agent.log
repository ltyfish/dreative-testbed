   <section className="hero" aria-labelledby="hero-title"><img src="/media/mv-hero-cast.png" alt="Three models wearing representative Marlow & Vale clothing"/><h1 id="hero-title"><span>Nine good</span><span>things.</span><span className="hero-right">No seasons.</span></h1><p className="hero-copy">Clothes made in four factories we have been to, sold at one price all year.</p><p className="image-note">Campaign imagery is illustrative of this fictional collection.</p><a className="scroll-cue" href="#shop">Scroll to shop <span>↓</span></a></section>
   <section id="shop" className="shop" aria-labelledby="shop-title"><div className="category-rail" role="group" aria-label="Filter garments"><button className={category==='All'?'active':''} onClick={()=>selectCategory('All')}>All <b>09</b></button>{CATEGORIES.map(c=><button key={c} className={category===c?'active':''} onClick={()=>selectCategory(c)}>{c} <b>0{GARMENTS.filter(g=>g.category===c).length}</b></button>)}</div><div className="rail-heading"><div><span>Permanent collection</span><h2 id="shop-title">One long rail.</h2></div><p>Showing {shown.length} of {GARMENTS.length} garments{category==='All'?'':` in ${category}`}.</p><div className="rail-arrows"><button aria-label="Previous garments" onClick={()=>railRef.current?.scrollBy({left:-railRef.current.clientWidth*.72,behavior:'smooth'})}>←</button><button aria-label="Next garments" onClick={()=>railRef.current?.scrollBy({left:railRef.current.clientWidth*.72,behavior:'smooth'})}>→</button></div></div>
    <div className="product-rail" ref={railRef} tabIndex="0">{shown.map(g=>{const i=GARMENTS.indexOf(g);return <button key={g.id} className={`product-tile ${active.id===g.id?'selected':''}`} onClick={()=>setActiveId(g.id)} aria-pressed={active.id===g.id}><span className="product-image" style={{'--col':i%3,'--row':Math.floor(i/3)}} aria-hidden="true"/><span className="product-meta"><span>{g.name}</span><b>£{g.price}</b></span></button>})}</div>
    <article className="product-stage" aria-live="polite"><div className="stage-title"><span>{String(GARMENTS.indexOf(active)+1).padStart(2,'0')} — 09 / {active.category}</span><h3>{active.name}</h3><strong>£{active.price}</strong></div><div className="stage-image"><span className="product-image" style={{'--col':GARMENTS.indexOf(active)%3,'--row':Math.floor(GARMENTS.indexOf(active)/3)}}/></div><div className="stage-buy"><p className="detail">{active.detail}</p><p className="fabric">{active.fabric}</p><fieldset><legend>Colour</legend><div className="swatches">{active.colours.map((c,i)=><span key={c}><i style={{'--swatch':['#111','#e9e7df','#775848','#123663'][i%4]}}/>{c}</span>)}</div></fieldset><fieldset><legend>Choose a size</legend><div className="sizes">{SIZES.map(s=><button key={s} disabled={active.sold.includes(s)} className={chosen[active.id]===s?'chosen':''} onClick={()=>setChosen({...chosen,[active.id]:s})}>{s}{active.sold.includes(s)&&<small>Sold out</small>}</button>)}</div></fieldset><div className="buy-row"><button className="add-button" disabled={!chosen[active.id]} onClick={()=>add(active)}>{chosen[active.id]?`Add size ${chosen[active.id]} to bag`:'Choose a size'}</button><a href="#fit-care">Check the size guide</a></div></div></article>
   </section><PixelField/>
-  <section id="fit-care" className="info-matrix"><div className="info-intro"><span>Useful facts, kept visible.</span><h2>Buy it once.<br/>Know it well.</h2></div><article className={`info-panel size-panel ${infoOpen==='size'?'open':''}`}><button onClick={()=>setInfoOpen(infoOpen==='size'?'':'size')}><span>01</span> Size chart <b>{infoOpen==='size'?'−':'+'}</b></button><div className="panel-body"><p>Body measurements in centimetres.</p><table><thead><tr><th>Size</th><th>Chest</th><th>Waist</th><th>Sleeve</th></tr></thead><tbody>{SIZE_CHART.map(r=><tr key={r.size}><th>{r.size}</th><td>{r.chest}</td><td>{r.waist}</td><td>{r.sleeve}</td></tr>)}</tbody></table><p className="advice">Between two sizes? Everything except the knitwear is cut with room, so take the smaller one.</p></div></article><article className={`info-panel care-panel ${infoOpen==='care'?'open':''}`}><button onClick={()=>setInfoOpen(infoOpen==='care'?'':'care')}><span>02</span> Care for a longer life <b>{infoOpen==='care'?'−':'+'}</b></button><div className="panel-body care-list">{CARE.map((x,i)=><div key={x}><strong>0{i+1}</strong><p>{x}</p></div>)}</div></article><article className={`info-panel ship-panel ${infoOpen==='ship'?'open':''}`}><button onClick={()=>setInfoOpen(infoOpen==='ship'?'':'ship')}><span>03</span> Shipping &amp; returns <b>{infoOpen==='ship'?'−':'+'}</b></button><div className="panel-body ship-list">{SHIPPING.map((x,i)=><p key={x}><strong>{['UK','Europe','World','60 days','Exchange'][i]}</strong>{x}</p>)}</div></article></section>
+  <section id="fit-care" className="info-matrix"><div className="info-intro"><span>Useful facts, kept visible.</span><h2>Buy it once.<br/>Know it well.</h2></div><article className={`info-panel size-panel ${infoOpen==='size'?'open':''}`}><button aria-expanded={infoOpen==='size'} onClick={()=>setInfoOpen(infoOpen==='size'?'':'size')}><span>01</span> Size chart <b>{infoOpen==='size'?'−':'+'}</b></button><div className="panel-body"><p>Body measurements in centimetres.</p><table><thead><tr><th>Size</th><th>Chest</th><th>Waist</th><th>Sleeve</th></tr></thead><tbody>{SIZE_CHART.map(r=><tr key={r.size}><th>{r.size}</th><td>{r.chest}</td><td>{r.waist}</td><td>{r.sleeve}</td></tr>)}</tbody></table><p className="advice">Between two sizes? Everything except the knitwear is cut with room, so take the smaller one.</p></div></article><article className={`info-panel care-panel ${infoOpen==='care'?'open':''}`}><button aria-expanded={infoOpen==='care'} onClick={()=>setInfoOpen(infoOpen==='care'?'':'care')}><span>02</span> Care for a longer life <b>{infoOpen==='care'?'−':'+'}</b></button><div className="panel-body care-list">{CARE.map((x,i)=><div key={x}><strong>0{i+1}</strong><p>{x}</p></div>)}</div></article><article className={`info-panel ship-panel ${infoOpen==='ship'?'open':''}`}><button aria-expanded={infoOpen==='ship'} onClick={()=>setInfoOpen(infoOpen==='ship'?'':'ship')}><span>03</span> Shipping &amp; returns <b>{infoOpen==='ship'?'−':'+'}</b></button><div className="panel-body ship-list">{SHIPPING.map((x,i)=><p key={x}><strong>{['UK','Europe','World','60 days','Exchange'][i]}</strong>{x}</p>)}</div></article></section>
   <section className="reviews" aria-labelledby="reviews-title"><div><span>Worn, washed, reported back.</span><h2 id="reviews-title">Three wardrobes.</h2></div>{REVIEWS.map((r,i)=><blockquote key={r.name}><span>0{i+1}</span><p>“{r.text}”</p><footer><strong>{r.name}</strong> bought the {r.bought}</footer></blockquote>)}</section>
   <section id="about" className="about"><div className="pixel-portrait" aria-hidden="true"/><h2>Eleven people.<br/>One shop in Leeds.<br/>Four factories.<br/><em>Never any sales.</em></h2><div>{ABOUT.map(x=><p key={x}>{x}</p>)}</div></section>
  </main><footer className="footer"><strong>MARLOW &amp; VALE</strong><p>A smaller wardrobe.<br/>A brighter tomorrow.</p><a href="#top">Back to top ↑</a></footer>
