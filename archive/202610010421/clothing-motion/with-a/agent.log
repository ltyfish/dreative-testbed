+++ b/runs/clothing-motion__with-a__202610010421/.dreative/verify-shop.mjs
@@ -0,0 +1,102 @@
+import { chromium } from 'playwright'
+
+const url = 'http://127.0.0.1:5173'
+const browser = await chromium.launch({ headless: true })
+
+async function desktopFlow() {
+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } })
+  const errors = []
+  page.on('console', (message) => { if (message.type() === 'error') errors.push(message.text()) })
+  await page.goto(url, { waitUntil: 'networkidle' })
+  await page.locator('#shop').scrollIntoViewIfNeeded()
+  const allCards = await page.locator('.product-card').count()
+  if (allCards !== 9) throw new Error(`Expected 9 garments, found ${allCards}`)
+  const soldOut = { oxford: ['XS'], tee: [], chore: ['S', 'XL'], overshirt: [], trouser: ['M'], jean: [], knit: ['L'], cardigan: ['XS', 'S'], shorts: ['XL'] }
+  for (const [id, expected] of Object.entries(soldOut)) {
+    const actual = await page.locator(`[data-product-id="${id}"] .size-row button:disabled`).allTextContents()
+    if (JSON.stringify(actual) !== JSON.stringify(expected)) throw new Error(`${id} sold-out sizes ${JSON.stringify(actual)} did not match ${JSON.stringify(expected)}`)
+  }
+  const pageText = await page.locator('main').textContent()
+  const requiredFacts = [
+    'Everything here is washable at 30°C except the knitwear and the wool overshirt, which are hand wash or wool cycle only.',
+    'Nothing we sell should go in a tumble dryer.',
+    'The denim is unwashed. Wash it cold and inside out, and expect it to bleed onto light upholstery for the first few wears.',
+    'We will repair anything we made, for as long as we are trading. Send it back and we quote before doing the work.',
+    'Europe is £12 and five to seven working days, duties included.',
+    'Rest of the world is £22 and seven to fourteen working days, duties not included.',
+    '60 days to return anything unworn with its tags on, and return postage is free in the UK.',
+    'Exchanges for a different size ship the same day the return is scanned, so you are not waiting twice.',
+    'Priya N.', 'Daniel O.', 'Marta K.', 'Eleven people, one shop in Leeds', 'We do not run sales.'
+  ]
+  for (const fact of requiredFacts) if (!pageText.includes(fact)) throw new Error(`Missing required fact: ${fact}`)
+  const tableRows = await page.locator('#sizing tbody tr').allTextContents()
+  if (tableRows.length !== 5 || !tableRows.join(' ').includes('120') || !tableRows.join(' ').includes('107')) throw new Error('Size table is incomplete')
+  const oxford = page.locator('[data-product-id="oxford"]')
+  if (!(await oxford.getByRole('button', { name: 'XS, sold out' }).isDisabled())) throw new Error('Oxford XS should be sold out')
+  await oxford.getByRole('button', { name: 'Choose size M' }).click()
+  await oxford.getByRole('button', { name: /Add to bag/ }).click()
+  const drawer = page.getByRole('dialog', { name: 'Shopping bag' })
+  await drawer.waitFor({ state: 'visible' })
+  const bagText = await drawer.textContent()
+  for (const expected of ['The Oxford Shirt', 'Size M', '£78', 'Subtotal', '£22.00 more for free delivery']) {
+    if (!bagText.includes(expected)) throw new Error(`Bag missing ${expected}`)
+  }
+  await drawer.getByRole('button', { name: 'Remove' }).click()
+  if (!(await drawer.textContent()).includes('Your bag is empty')) throw new Error('Remove did not empty bag')
+  await page.keyboard.press('Escape')
+  await page.getByRole('button', { name: /Outerwear/ }).click()
+  await page.waitForTimeout(800)
+  if (await page.locator('.product-card').count() !== 2) throw new Error('Outerwear filter did not produce 2 garments')
+  if (errors.length) throw new Error(`Console errors: ${errors.join(' | ')}`)
+  await page.close()
+  return { allCards, bag: 'add/remove/subtotal/free-delivery progress verified', filter: 'Outerwear 2 verified', soldOut: 'all nine sold-out mappings verified', content: 'care, shipping, returns, reviews, shop facts and five size rows verified' }
+}
+
+async function mobileFlow() {
+  const page = await browser.newPage({ viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true })
+  await page.goto(url, { waitUntil: 'networkidle' })
+  await page.locator('#shop').scrollIntoViewIfNeeded()
+  await page.getByRole('button', { name: /Trousers/ }).tap()
+  await page.waitForTimeout(800)
+  if (await page.locator('.product-card').count() !== 3) throw new Error('Touch trousers filter did not produce 3 garments')
+  const trouser = page.locator('[data-product-id="trouser"]')
+  if (!(await trouser.getByRole('button', { name: 'M, sold out' }).isDisabled())) throw new Error('Pleated Trouser M should be sold out')
+  await trouser.getByRole('button', { name: 'Choose size S' }).tap()
+  await trouser.getByRole('button', { name: /Add to bag/ }).tap()
+  if (!(await page.getByRole('dialog', { name: 'Shopping bag' }).textContent()).includes('Pleated Trouser')) throw new Error('Mobile bag missing Pleated Trouser')
+  await page.close()
+  return { filter: 'Trousers 3 via touch verified', soldOut: 'Pleated Trouser M disabled verified', bag: 'bottom sheet add verified' }
+}
+
+async function reducedMotion() {
+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' })
+  await page.goto(url, { waitUntil: 'networkidle' })
+  const height = await page.locator('#top').evaluate((element) => element.getBoundingClientRect().height)
+  const transform = await page.locator('.hero-figure').evaluate((element) => getComputedStyle(element).transform)
+  if (height > 1200) throw new Error(`Reduced-motion hero remains scroll-pinned: ${height}`)
+  if (transform !== 'none') throw new Error(`Reduced-motion hero has transform: ${transform}`)
+  await page.locator('#shop').scrollIntoViewIfNeeded()
+  if (await page.locator('.product-card').count() !== 9) throw new Error('Reduced-motion shop not fully present')
+  await page.screenshot({ path: '.dreative/asset-review/reduced-motion.png', fullPage: false })
+  await page.close()
+  return { heroHeight: height, heroTransform: transform, shop: '9 garments visible' }
+}
+
+async function narrowViewport() {
+  const page = await browser.newPage({ viewport: { width: 320, height: 720 }, isMobile: true, hasTouch: true })
+  await page.goto(url, { waitUntil: 'networkidle' })
+  const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth)
+  if (overflow > 1) {
+    const offenders = await page.evaluate(() => [...document.querySelectorAll('body *')].map((element) => ({ selector: `${element.tagName.toLowerCase()}.${element.className || ''}`, left: element.getBoundingClientRect().left, right: element.getBoundingClientRect().right, width: element.getBoundingClientRect().width })).filter((item) => item.right > document.documentElement.clientWidth + 1 || item.left < -1).sort((a, b) => b.right - a.right).slice(0, 12))
+    throw new Error(`320px viewport has ${overflow}px horizontal overflow: ${JSON.stringify(offenders)}`)
+  }
+  await page.locator('#sizing').scrollIntoViewIfNeeded()
+  const minButton = await page.locator('[data-product-id="oxford"] .size-row button').first().evaluate((element) => element.getBoundingClientRect().height)
+  if (minButton < 44) throw new Error(`Touch target is only ${minButton}px high`)
+  await page.close()
+  return { horizontalOverflow: overflow, minimumSizeTarget: minButton }
+}
+
+const result = { desktop: await desktopFlow(), mobile: await mobileFlow(), reducedMotion: await reducedMotion(), narrowViewport: await narrowViewport() }
+console.log(JSON.stringify(result, null, 2))
+await browser.close()
