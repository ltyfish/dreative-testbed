+
+  .service-grid { display: grid; grid-template-columns: 5fr 3fr 4fr; min-height: 900px; border-bottom: 1px solid var(--line); }
+  .service-grid > * { padding: 5vw 3vw; border-right: 1px solid var(--line); }
