+@layer reset, base, layout, components, responsive;
+
+@layer reset {
+  *, *::before, *::after { box-sizing: border-box; }
+  html { overflow-x: clip; scroll-padding-top: 4rem; }
+  body, h1, h2, h3, p, figure, blockquote, ol { margin: 0; }
+  button, input, table { font: inherit; }
+  img { display: block; max-width: 100%; }
+  button, a { -webkit-tap-highlight-color: transparent; }
+}
+
+@layer base {
+  :root {
+    --paper: #f1eee5;
+    --paper-deep: #e6e0d3;
+    --ink: #171714;
+    --quiet: #706c63;
+    --rust: #a6422b;
+    --blue: #253348;
+    --line: rgba(23, 23, 20, .22);
+    --display: Didot, "Bodoni MT", "Times New Roman", serif;
+    --body: Arial, Helvetica, sans-serif;
+    --ease: cubic-bezier(.16, 1, .3, 1);
+  }
+
+  html { background: var(--paper); color: var(--ink); }
+  body { min-width: 320px; overflow-x: clip; background: var(--paper); font-family: var(--body); font-size: 15px; line-height: 1.45; }
+  body::before { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 100; opacity: .22; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E"); mix-blend-mode: multiply; }
+  a { color: inherit; text-decoration: none; }
+  button { color: inherit; }
+  button:focus-visible, a:focus-visible { outline: 2px solid var(--rust); outline-offset: 3px; }
+  ::selection { background: var(--rust); color: white; }
+  .eyebrow { color: var(--quiet); font-family: var(--body); font-size: .75rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
+  .skip-link { position: fixed; top: .5rem; left: .5rem; z-index: 120; padding: .65rem 1rem; background: var(--ink); color: white; transform: translateY(-150%); }
+  .skip-link:focus { transform: translateY(0); }
+}
+
+@layer layout {
+  .topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 60; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 48px; padding: 0 2vw; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(12px); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
+  .topbar nav { display: flex; gap: 2rem; }
+  .topbar nav a, .bag-button { transition: color .25s ease; }
+  .topbar nav a:hover, .bag-button:hover { color: var(--rust); }
+  .mini-brand { font-family: var(--display); font-size: .92rem; letter-spacing: -.02em; text-transform: none; }
+  .bag-button { justify-self: end; display: flex; align-items: center; gap: .25rem; border: 0; background: transparent; cursor: pointer; text-transform: uppercase; }
+  .bag-button i { width: 7px; height: 7px; margin-left: .35rem; border-radius: 50%; background: var(--rust); }
+
+  .hero-bridge { height: 215vh; min-height: 1450px; border-bottom: 1px solid var(--line); }
+  .hero-sticky { position: sticky; top: 0; height: 100vh; min-height: 650px; overflow: hidden; padding: 8vh 2vw 3vh; background: var(--paper); }
+  .hero-wordmark { position: absolute; top: 7vh; left: 2vw; z-index: 4; display: flex; flex-direction: column; width: 47vw; font-family: var(--display); font-size: clamp(5.6rem, 10.8vw, 11rem); font-weight: 400; letter-spacing: -.085em; line-height: .72; text-transform: uppercase; pointer-events: none; }
+  .wordmark-right { margin-left: 3vw; white-space: nowrap; }
+  .hero-copy { position: absolute; z-index: 6; left: 3vw; top: 48vh; width: 26vw; }
+  .hero-copy > p { max-width: 15ch; font-family: var(--display); font-size: clamp(1.4rem, 2.25vw, 2.4rem); line-height: 1.02; letter-spacing: -.04em; }
+  .hero-copy > span { display: block; margin-top: 10vh; padding-left: 1rem; border-left: 1px solid var(--ink); font-size: .75rem; font-weight: 700; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; }
+  .hero-figure { position: absolute; z-index: 2; top: 5vh; right: 11.5vw; width: min(48vw, 730px); height: 83vh; transform-origin: 50% 50%; }
+  .hero-figure > img { width: 100%; height: 100%; object-fit: cover; object-position: 51% 30%; }
+  .crop-frame { position: absolute; inset: 12% -2.5% 9% 24%; border: 4px solid var(--rust); pointer-events: none; }
+  .cross-mark { position: absolute; right: -12vw; bottom: 9%; width: 45px; height: 45px; }
+  .cross-mark i, .cross-mark b { position: absolute; display: block; background: currentColor; opacity: .65; }
+  .cross-mark i { left: 50%; top: 0; bottom: 0; width: 1px; }
+  .cross-mark b { top: 50%; left: 0; right: 0; height: 1px; }
+  .image-disclosure { position: absolute; right: 0; bottom: -1.6rem; color: var(--quiet); font-size: .75rem; letter-spacing: .13em; text-transform: uppercase; }
+  .hero-side-note { position: absolute; top: 19vh; right: 3vw; width: 8ch; font-size: .75rem; font-weight: 700; letter-spacing: .16em; line-height: 1.55; text-transform: uppercase; }
+  .hero-foot { position: absolute; z-index: 8; left: 2vw; right: 2vw; bottom: 2.8vh; display: grid; grid-template-columns: 1fr auto 1fr; font-size: .75rem; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
+  .hero-foot span:last-child { justify-self: end; }
+  .scroll-cue { color: var(--quiet); }
+  .handoff-label { position: absolute; z-index: 10; left: 7.8vw; bottom: 4vh; display: flex; gap: .75rem; align-items: center; opacity: 0; transform: translateY(20px); font-family: var(--display); font-size: 1.5rem; }
+  .handoff-label span { font-family: var(--body); font-size: .75rem; letter-spacing: .12em; }
+
+  .shop { padding: 7rem 2vw 9rem; background: var(--paper); }
+  .shop-intro { display: grid; grid-template-columns: 2fr 4fr 3fr; gap: 2vw; align-items: end; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
+  .shop-intro h2 { font-family: var(--display); font-size: clamp(2.1rem, 3.6vw, 4rem); font-weight: 400; letter-spacing: -.055em; line-height: .82; text-transform: uppercase; }
+  .shop-intro > p:last-child { max-width: 30ch; color: var(--quiet); }
+  .filter-bar { position: relative; z-index: 20; display: grid; grid-template-columns: 1fr 8fr 2fr; align-items: center; min-height: 72px; margin: 0 -2vw 3rem; padding: 0 2vw; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); }
+  .filter-bar > span, .filter-bar > p { color: var(--quiet); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
+  .filter-bar > p { justify-self: end; }
+  .filter-scroll { display: flex; align-items: center; }
+  .filter-scroll button { min-height: 44px; padding: 0 2rem; border: 0; border-left: 1px solid var(--line); background: transparent; cursor: pointer; font-family: var(--display); font-size: 1.15rem; white-space: nowrap; }
+  .filter-scroll button.active { color: var(--rust); }
+  .filter-scroll sup { margin-left: .35rem; font-family: var(--body); font-size: .75rem; }
+  .product-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.25vw; row-gap: 9rem; align-items: start; }
+  .product-card { grid-column: span 4; min-width: 0; }
+  .product-1 { grid-column: 1 / span 3; }
+  .product-2 { grid-column: 4 / span 4; padding-top: 8rem; }
+  .product-3 { grid-column: 9 / span 4; }
+  .product-4 { grid-column: 1 / span 5; }
+  .product-5 { grid-column: 6 / span 3; padding-top: 12rem; }
+  .product-6 { grid-column: 10 / span 3; padding-top: 4rem; }
+  .product-7 { grid-column: 1 / span 3; padding-top: 8rem; }
+  .product-8 { grid-column: 5 / span 4; }
+  .product-9 { grid-column: 9 / span 4; padding-top: 10rem; }
+  .product-grid.is-filtered .product-card:nth-child(odd) { grid-column: 1 / span 5; padding-top: 0; }
+  .product-grid.is-filtered .product-card:nth-child(even) { grid-column: 7 / span 5; padding-top: 8rem; }
+  .product-media-wrap { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--paper-deep); }
+  .product-media { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform .8s var(--ease); }
+  .product-card:hover .product-media { transform: scale(1.025); }
+  .product-1 .product-media-wrap { border: 3px solid var(--rust); }
+  .product-1 .product-media { object-position: 51% 29%; }
+  .product-4 .product-media, .product-9 .product-media { object-position: center 35%; }
+  .product-inset { position: absolute; right: .8rem; bottom: .8rem; width: 26%; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid rgba(255,255,255,.7); box-shadow: 0 5px 18px rgba(0,0,0,.15); }
+  .product-index { position: absolute; top: .75rem; left: .75rem; display: grid; place-items: center; width: 2rem; height: 2rem; background: var(--paper); font-size: .75rem; font-weight: 700; }
+  .product-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding: 1.1rem 0 .9rem; border-bottom: 1px solid var(--line); }
+  .product-heading > div { min-width: 0; }
+  .product-heading h3 { margin-top: .2rem; font-family: var(--display); font-size: clamp(1.55rem, 2.2vw, 2.35rem); font-weight: 400; letter-spacing: -.035em; line-height: .95; }
+  .product-price { flex: none; font-family: var(--display); font-size: 1.5rem; }
+  .product-detail { min-height: 5.8em; padding: .9rem 0; font-family: var(--display); font-size: 1.12rem; line-height: 1.2; }
+  .product-fabric, .product-colours { padding: .65rem 0; border-top: 1px solid var(--line); color: var(--quiet); font-size: .75rem; }
+  .product-colours span { display: inline-block; width: 4.2rem; color: var(--ink); text-transform: uppercase; letter-spacing: .08em; }
+  .size-picker { margin: .8rem 0 0; padding: 0; border: 0; }
+  .size-picker legend { margin-bottom: .45rem; color: var(--quiet); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
+  .size-row { display: grid; grid-template-columns: repeat(5, 1fr); }
+  .size-row button { position: relative; min-height: 46px; border: 1px solid var(--line); border-right: 0; background: transparent; cursor: pointer; transition: background .2s, color .2s; }
+  .size-row button:last-child { border-right: 1px solid var(--line); }
+  .size-row button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
+  .size-row button:disabled { color: #918d85; cursor: not-allowed; }
+  .sold-slash { display: none; position: absolute; inset: 50% 15% auto; height: 1px; background: var(--rust); transform: rotate(-18deg); }
+  .size-row button:disabled .sold-slash { display: block; }
+  .product-action { display: grid; grid-template-columns: 1fr 1.35fr; align-items: center; margin-top: .75rem; }
+  .product-action > span { color: var(--quiet); font-size: .75rem; }
+  .add-button, .checkout { min-height: 48px; border: 0; background: var(--ink); color: var(--paper); cursor: pointer; transition: background .2s, color .2s; }
+  .add-button { display: flex; justify-content: space-between; align-items: center; padding: 0 1rem; }
+  .add-button:hover, .checkout:hover { background: var(--rust); }
+  .add-button:disabled { background: #d2ccc0; color: #777269; cursor: not-allowed; }
+
