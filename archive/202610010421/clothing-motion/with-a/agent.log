+  .fabric-photo img { object-position: 63% 40%; }
+
+  .reviews { display: grid; grid-template-columns: 4fr 8fr; padding: 9rem 2vw; border-bottom: 1px solid var(--line); }
+  .reviews-heading { position: sticky; top: 8rem; align-self: start; }
+  .reviews h2 { margin-top: 1.2rem; }
+  .review-list { border-top: 1px solid var(--ink); }
