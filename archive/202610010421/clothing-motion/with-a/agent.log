+function BagDrawer({ bag, open, onClose, onRemove }) {
+  const closeRef = useRef(null)
+  const total = bag.reduce((sum, line) => sum + line.price, 0)
+  const postage = total === 0 || total >= 100 ? 0 : 4.95
