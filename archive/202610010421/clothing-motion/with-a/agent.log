+  .measure-photo img { object-fit: cover; object-position: center; filter: saturate(.65) contrast(1.04); }
+  .size-content { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 5vw; }
+  .section-heading { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--ink); }
+  .section-heading h2, .care-panel h2, .shipping-panel h2, .reviews h2 { font-family: var(--display); font-size: clamp(3.2rem, 6vw, 6.5rem); font-weight: 400; letter-spacing: -.06em; line-height: .85; }
+  table { width: 100%; border-collapse: collapse; margin-top: 3rem; }
+  caption { padding-bottom: .75rem; text-align: left; color: var(--quiet); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
