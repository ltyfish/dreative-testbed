+  .site-footer { grid-column: 1 / -1; display: flex; justify-content: space-between; padding-top: 1rem; border-top: 1px solid var(--ink); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
+}
+
+@layer components {
+  .drawer-scrim { position: fixed; inset: 0; z-index: 69; border: 0; background: rgba(16,16,14,.35); opacity: 0; pointer-events: none; transition: opacity .45s ease; }
