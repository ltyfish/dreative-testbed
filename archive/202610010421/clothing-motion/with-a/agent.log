+  .shop-intro > p:last-child { max-width: 30ch; color: var(--quiet); }
+  .filter-bar { position: relative; z-index: 20; display: grid; grid-template-columns: 1fr 8fr 2fr; align-items: center; min-height: 72px; margin: 0 -2vw 3rem; padding: 0 2vw; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); }
+  .filter-bar > span, .filter-bar > p { color: var(--quiet); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
+  .filter-bar > p { justify-self: end; }
+  .filter-scroll { display: flex; align-items: center; }
+  .filter-scroll button { min-height: 44px; padding: 0 2rem; border: 0; border-left: 1px solid var(--line); background: transparent; cursor: pointer; font-family: var(--display); font-size: 1.15rem; white-space: nowrap; }
+  .filter-scroll button.active { color: var(--rust); }
+  .filter-scroll sup { margin-left: .35rem; font-family: var(--body); font-size: .75rem; }
+  .product-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.25vw; row-gap: 9rem; align-items: start; }
+  .product-card { grid-column: span 4; min-width: 0; }
+  .product-1 { grid-column: 1 / span 3; }
+  .product-2 { grid-column: 4 / span 4; padding-top: 8rem; }
+  .product-3 { grid-column: 9 / span 4; }
+  .product-4 { grid-column: 1 / span 5; }
+  .product-5 { grid-column: 6 / span 3; padding-top: 12rem; }
+  .product-6 { grid-column: 10 / span 3; padding-top: 4rem; }
+  .product-7 { grid-column: 1 / span 3; padding-top: 8rem; }
+  .product-8 { grid-column: 5 / span 4; }
+  .product-9 { grid-column: 9 / span 4; padding-top: 10rem; }
+  .product-grid.is-filtered .product-card:nth-child(odd) { grid-column: 1 / span 5; padding-top: 0; }
+  .product-grid.is-filtered .product-card:nth-child(even) { grid-column: 7 / span 5; padding-top: 8rem; }
