+  .size-advice { max-width: 45ch; margin-top: 2rem; font-family: var(--display); font-size: 1.35rem; line-height: 1.15; }
+
+  .service-grid { display: grid; grid-template-columns: 5fr 3fr 4fr; min-height: 900px; border-bottom: 1px solid var(--line); }
+  .service-grid > * { padding: 5vw 3vw; border-right: 1px solid var(--line); }
+  .service-grid > *:last-child { border-right: 0; }
+  .care-panel h2, .shipping-panel h2 { margin: 1.2rem 0 3rem; font-size: clamp(3rem, 4.7vw, 5rem); }
+  .care-panel ol, .shipping-panel ol { list-style: none; padding: 0; }
+  .care-panel li, .shipping-panel li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.15rem 0; border-top: 1px solid var(--line); }
+  .care-panel li > span, .shipping-panel li > span { color: var(--rust); font-size: .75rem; font-weight: 700; letter-spacing: .1em; }
+  .fabric-photo { padding: 0; min-height: 760px; }
+  .fabric-photo img { object-position: 63% 40%; }
+
+  .reviews { display: grid; grid-template-columns: 4fr 8fr; padding: 9rem 2vw; border-bottom: 1px solid var(--line); }
+  .reviews-heading { position: sticky; top: 8rem; align-self: start; }
+  .reviews h2 { margin-top: 1.2rem; }
+  .review-list { border-top: 1px solid var(--ink); }
+  blockquote { display: grid; grid-template-columns: 1fr 7fr 2fr; gap: 2rem; padding: 3rem 0; border-bottom: 1px solid var(--line); }
+  blockquote > span { color: var(--rust); font-size: .75rem; letter-spacing: .1em; }
+  blockquote > p { font-family: var(--display); font-size: clamp(1.65rem, 2.5vw, 2.8rem); line-height: 1.05; letter-spacing: -.035em; }
+  blockquote footer { font-size: .75rem; line-height: 1.5; }
+  blockquote footer i { color: var(--quiet); font-style: normal; }
+
+  .story-ending { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5vw; padding: 9rem 2vw 2rem; }
+  .story-copy { grid-column: 1 / span 6; }
+  .story-copy h2 { margin: 1.75rem 0 3rem; font-family: var(--display); font-size: clamp(5rem, 9vw, 10rem); font-weight: 400; letter-spacing: -.075em; line-height: .72; text-transform: uppercase; }
+  .about-copy { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; max-width: 95%; }
+  .about-copy p { padding-top: 1rem; border-top: 1px solid var(--line); font-size: .76rem; }
+  .leeds-photo { grid-column: 7 / -1; align-self: end; aspect-ratio: 4 / 3; margin-top: 5rem; }
+  .leeds-photo img { object-position: 50% 60%; }
+  .factory-list { grid-column: 7 / -1; display: grid; grid-template-columns: 2fr repeat(2, 1fr); gap: .8rem 2rem; padding-top: 2rem; border-top: 1px solid var(--line); }
+  .factory-list p { grid-row: span 2; font-family: var(--display); font-size: 1.5rem; }
+  .factory-list span { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
+  .no-sales { grid-column: 1 / -1; margin: 7rem 0 5rem; color: var(--rust); font-family: var(--display); font-size: clamp(4rem, 8.2vw, 9rem); line-height: .8; letter-spacing: -.06em; text-align: center; text-transform: uppercase; }
+  .site-footer { grid-column: 1 / -1; display: flex; justify-content: space-between; padding-top: 1rem; border-top: 1px solid var(--ink); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
+}
+
+@layer components {
+  .drawer-scrim { position: fixed; inset: 0; z-index: 69; border: 0; background: rgba(16,16,14,.35); opacity: 0; pointer-events: none; transition: opacity .45s ease; }
+  .drawer-scrim.is-open { opacity: 1; pointer-events: auto; }
+  .bag-drawer { position: fixed; z-index: 70; top: 0; right: 0; display: flex; flex-direction: column; width: min(520px, 100vw); height: 100dvh; padding: 1.5rem; background: var(--paper); box-shadow: -20px 0 50px rgba(0,0,0,.15); transform: translateX(102%); transition: transform .5s var(--ease); visibility: hidden; }
+  .bag-drawer.is-open { transform: translateX(0); visibility: visible; }
+  .bag-header, .bag-title, .bag-summary > div { display: flex; justify-content: space-between; align-items: center; }
+  .bag-header { padding-bottom: 1rem; border-bottom: 1px solid var(--ink); }
+  .bag-header button { min-height: 44px; border: 0; background: transparent; cursor: pointer; }
+  .bag-header button span { margin-left: .5rem; font-size: 1.4rem; }
+  .bag-title { padding: 2rem 0; }
+  .bag-title h2 { font-family: var(--display); font-size: 3.8rem; font-weight: 400; letter-spacing: -.06em; }
+  .bag-title > span { color: var(--quiet); font-size: .75rem; text-transform: uppercase; }
+  .empty-bag { padding-top: 2rem; border-top: 1px solid var(--line); color: var(--quiet); }
+  .bag-lines { overflow-y: auto; }
+  .bag-line { display: grid; grid-template-columns: 2rem 1fr auto; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
+  .bag-line-number { color: var(--rust); font-size: .75rem; }
+  .bag-line div { display: flex; flex-direction: column; }
+  .bag-line div strong { font-family: var(--display); font-size: 1.35rem; font-weight: 400; }
+  .bag-line div span { color: var(--quiet); font-size: .75rem; }
+  .bag-line button { grid-column: 2; justify-self: start; padding: 0; border: 0; border-bottom: 1px solid; background: transparent; color: var(--quiet); cursor: pointer; font-size: .75rem; }
+  .bag-summary { margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--ink); }
