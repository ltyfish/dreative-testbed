+  .bag-summary p { color: var(--quiet); font-size: .75rem; }
+  .checkout { display: flex; justify-content: space-between; align-items: center; width: 100%; margin-top: 1rem; padding: 0 1rem; }
+  body.drawer-open { overflow: hidden; }
+}
