+  .bag-drawer.is-open { transform: translateX(0); visibility: visible; }
+  .bag-header, .bag-title, .bag-summary > div { display: flex; justify-content: space-between; align-items: center; }
+  .bag-header { padding-bottom: 1rem; border-bottom: 1px solid var(--ink); }
+  .bag-header button { min-height: 44px; border: 0; background: transparent; cursor: pointer; }
+  .bag-header button span { margin-left: .5rem; font-size: 1.4rem; }
